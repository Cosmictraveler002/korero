# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Used for OpenRouter AI API calls.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# NVIDIA_API_KEY: Used for NVIDIA NIM API calls.
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"

# GROQ_API_KEY: Used for Groq LPU models (Llama 3.3, GPT-OSS).
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# TAVILY_API_KEY: Used for web search intermediary results.
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"

# E2B_API_KEY: Used for Python code execution in isolated cloud sandbox.
E2B_API_KEY="YOUR_E2B_API_KEY"

# CLOUDFLARE_API_TOKEN: Used for Cloudflare Workers AI models and Flux 1 Schnell.
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"

# CLOUDFLARE_ACCOUNT_ID: Cloudflare Account ID for Workers AI and text-to-image endpoints.
CLOUDFLARE_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"

# APP_URL: The URL where this applet is hosted (or http://localhost:3000 in dev).
APP_URL="http://localhost:3000"
